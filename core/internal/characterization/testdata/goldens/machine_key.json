      }
    }
  },
  {
    "name": "machine_key.write_quote_refused",
    "request": {
      "method": "PUT",
      "path": "/api/v1/quotes/<id-2>/state",
      "headers": {
        "Authorization": "Bearer <api-key>"
      },
      "body": {
        "state": "DRAFT"
      }
    },
    "response": {
      "status": 403,
      "content_type": "application/json",
      "body": {
        "error": {
          "code": "forbidden",
          "message": "machine key lacks required scope quotes:write"
        },
        "meta": {
          "request_id": "<id-7>"
        }
      }
    }
  },
  {
    "name": "machine_key.refusal_audit_row",
    "request": {
      "method": "SQL",
      "path": "SELECT action, entity_type, entity_id::text AS entity_id, actor_kind, actor_id, user_id, changes FROM audit_log WHERE entity_type = 'api_key' AND entity_id = '<id-1>'::uuid ORDER BY created_at, id"
    },
    "response": {
      "status": 200,
      "content_type": "application/x-sql-rows",
      "body": [
        {
          "action": "key.scope_refused",
          "actor_id": "<id-1>",
          "actor_kind": "key",
          "changes": {
            "method": "PUT",
            "path": "/api/v1/quotes/<id-2>/state",
            "scope": "quotes:write"
          },
          "entity_id": "<id-1>",
          "entity_type": "api_key",
          "user_id": null
        }
      ]
    }
  },
  {
    "name": "machine_key.user_only_refused",
    "request": {
      "method": "GET",
      "path": "/api/v1/admin/keys",
      "headers": {
        "Authorization": "Bearer <api-key>"
      }
    },
    "response": {
      "status": 403,
      "content_type": "application/json",
      "body": {
        "error": {
          "code": "forbidden",
          "message": "key management requires a user"
        },
        "meta": {
          "request_id": "<id-8>"
        }
      }
    }
  },
  {
    "name": "machine_key.unknown_key",
    "request": {
      "method": "GET",
      "path": "/api/v1/quotes/<id-2>",
      "headers": {
        "Authorization": "Bearer <api-key>"
      }
    },
    "response": {
      "status": 401,
      "content_type": "application/json",
      "body": {
        "error": {
          "code": "unauthorized",
          "message": "invalid machine key"
        },
        "meta": {
          "request_id": "<id-9>"
        }
      }
    }
  }
]
