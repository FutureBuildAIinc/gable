[
  {
    "name": "machine_key.create",
    "request": {
      "method": "POST",
      "path": "/api/v1/admin/keys",
      "body": {
        "name": "golden-scoped-key",
        "scopes": [
          "quotes:read"
        ]
      }
    },
    "response": {
      "status": 200,
      "content_type": "application/json",
      "body": {
        "api_key": "<api-key>",
        "key": {
          "created_at": "<ts+0d>",
          "id": "<id-1>",
          "last_used_at": null,
          "name": "golden-scoped-key",
          "prefix": "<api-key>",
          "revoked_at": null,
          "scopes": [
            "quotes:read"
          ]
        }
      }
    }
  },
  {
    "name": "machine_key.read_quote",
    "request": {
      "method": "GET",
      "path": "/api/v1/quotes/<id-2>",
      "headers": {
        "Authorization": "Bearer <api-key>"
      }
    },
    "response": {
      "status": 200,
      "content_type": "application/json",
      "body": {
        "accepted_at": "<ts+0d>",
        "branch_id": "<id-3>",
        "created_at": "<ts+0d>",
        "customer_id": "<id-4>",
        "customer_name": "Kelbrook Construction",
        "delivery_type": "PICKUP",
        "exposure_dollars": 0,
        "exposure_last_checked_at": "<ts+0d>",
        "exposure_state": "OK",
        "freight_amount": 0,
        "id": "<id-2>",
        "lines": [
          {
            "created_at": "<ts+0d>",
            "description": "2x4x8 SPF Premium",
            "id": "<id-5>",
            "line_total": 110,
            "product_id": "<id-6>",
            "quantity": 20,
            "quote_id": "<id-2>",
            "sku": "LUM-248-PREM",
            "unit_cost": 3.5,
            "unit_price": 5.5,
            "uom": "PCS"
          }
        ],
        "margin_total": 0,
