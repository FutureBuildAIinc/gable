#
# Gable backend configuration. Copy to backend/.env and fill in.
# NEVER commit a filled-in .env — it holds live credentials.
#
# The backend is FAIL-CLOSED: outside AUTH_MODE=dev it refuses to start unless
# every required variable below is set. A missing variable is a boot failure,
# not a silently skipped check.

# ---------------------------------------------------------------------------
# Auth mode — the master switch
# ---------------------------------------------------------------------------
# AUTH_MODE=dev disables authentication and authorization ENTIRELY: no JWT is
# verified and every role check passes. Safe only on your own machine against
# throwaway data. Never set it on a reachable or production deployment.
# Leave it unset (or set anything other than "dev") for production.
AUTH_MODE=dev

# ---------------------------------------------------------------------------
# JWT verification — all three are REQUIRED unless AUTH_MODE=dev
# ---------------------------------------------------------------------------
# Your identity provider's JWKS endpoint.
JWKS_URL=https://auth.example.com/.well-known/jwks.json

# The exact `iss` every access token must carry. Must match your IdP exactly,
# trailing slash included.
AUTH_ISSUER=https://auth.example.com/

# The audience this service accepts — REQUIRED unless AUTH_MODE=dev.
# Without it, a token minted for a DIFFERENT service in the same IdP is a
# valid token here: it is signed by the same JWKS. Set it to this service's
# own identifier, not a shared one.
AUTH_AUDIENCE=gable-erp

# Optional: narrow the accepted JWT signing algorithms (comma-separated).
# Unset means the asymmetric default set:
#   RS256 RS384 RS512 PS256 PS384 PS512 ES256 ES384 ES512 EdDSA
# Symmetric ("HS*") and "none" are rejected at boot and can never be enabled —
# this service verifies against a JWKS of PUBLIC keys, so an HMAC algorithm
# would mean verifying with material an attacker can also read.
# Recommended: pin to exactly what your IdP signs with.
AUTH_ALGORITHMS=RS256

# Browser origins allowed to call the API — REQUIRED unless AUTH_MODE=dev.
CORS_ORIGINS=https://app.example.com

# Signing secret for customer-portal sessions. Required in production; a
# dev-only default is used under AUTH_MODE=dev.
#   openssl rand -hex 32
PORTAL_JWT_SECRET=

# ---------------------------------------------------------------------------
# Payment credential vault — REQUIRED unless AUTH_MODE=dev
# ---------------------------------------------------------------------------
# Seals the Run Payments api_key and refresh_token at rest (AES-256-GCM) in
# system_settings. Generate with:
#   openssl rand -hex 32
#
# Despite the name, this seals EVERY admin-settable credential in
# system_settings, not just the payment ones: run_payments_api_key,
# run_payments_refresh_token, openrouter_api_key and openrouteservice_api_key.
# The name is kept for continuity with deployed environments.
#
# Fail-closed, and stricter than the auth vars:
#   - A MALFORMED key refuses to boot in EVERY mode, dev included. A typo must
#     never silently downgrade payment credentials to plaintext.
#   - An ABSENT key refuses to boot unless AUTH_MODE=dev.
#   - With no key set, a credential WRITE is refused outright (the admin sees
#     the save fail) rather than degrading to a plaintext row.
# Treat this as a secret: rotating it makes existing sealed values unreadable.
PAYMENT_VAULT_KEY=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://gable_user:gable_password@localhost:5434/gable_db?sslmode=disable

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8080
LOG_LEVEL=INFO
