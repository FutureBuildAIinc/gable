# Environment files. Only the `.env.example` templates are tracked; copy one to
# `.env` locally. The frontend works with no `.env` at all — an unset
# VITE_API_URL routes through the Vite proxy (see app/.env.example).
**/.env
**/.env.*
!**/.env.example

# Local docker compose override (developer-specific tweaks)
docker-compose.override.yml

# Build artifacts
backend/server
backend/server_bin
backend/main
backend/migrate
backend/seed
*.log

# Stray binary that ended up committed at the repo root — do not re-add.
/docker-compose

# Agent/AI directories.
#
# `.claude/` IS tracked on purpose: it ships the shared contributor agent kit
# (skills + slash commands) that every contributor gets on clone — see
# CONTRIBUTING-WITH-CLAUDE.md. Only per-developer local overrides are ignored.
.agents/
.claude/settings.local.json
.claude/**/*.local.json

# IDE
.idea/
.vscode/
*.swp
*.swo

# Dependencies
node_modules/

# Build output
dist/

# Coverage & CI reports. These are produced by `make cover` / `make fe-cover`
# and by the backend/frontend jobs in .github/workflows/ci.yml, which upload
# them as build artifacts. They are never committed.
coverage.out
coverage-func.txt
govulncheck.txt
coverage/
*.lcov

# Digital Ocean — keep .do/*.yaml tracked, but ignore any local-only manifests
# (e.g. dev-scratch specs or secret env files dropped alongside).
.do/*.local.*
.do/.env*

# OS
.DS_Store
Thumbs.db

# Python bytecode (reuse_gate.py in .github/scripts)
__pycache__/
*.pyc
